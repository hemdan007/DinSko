
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DinSko</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DinSko.styles.css" asp-append-version="true" />
</head>

<body>

    <!-- Main Navigation -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
            <div class="container">

                <!-- Website Logo -->
                <a class="navbar-brand fw-bold fs-3" asp-page="/Index">
                    DinSko<span class="text-warning">.</span>
                </a>

                <!-- Mobile Navigation Button -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <!-- Navigation Links -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-page="/Index">
                                Home
                            </a>
                        </li>

                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-page="/Cart/Index">
                                    My Cart
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-page="/Account/ChangePassword">
                                    Change Password
                                </a>
                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-semibold"
                                       asp-page="/Admin/Products">
                                        Admin Products
                                    </a>
                                </li>
                            }
                        }

                    </ul>

                    <!-- Account Actions -->
                    <div class="d-flex align-items-center gap-2">

                        @if (User.Identity.IsAuthenticated)
                        {
                            <span class="text-secondary small me-2">
                                @User.Identity.Name
                            </span>

                            <form method="post" asp-page="/Account/Logout">
                                <button type="submit"
                                        class="btn btn-outline-dark btn-sm">
                                    Logout
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-page="/Account/Login"
                               class="btn btn-dark btn-sm">
                                Login
                            </a>

                            <a asp-page="/Account/Register"
                               class="btn btn-outline-dark btn-sm">
                                Register
                            </a>
                        }

                    </div>

                </div>
            </div>
        </nav>
    </header>

    <!-- Main Page Content -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="border-top text-muted mt-4 py-4">
        <div class="container text-center">
            <strong>DinSko.</strong>
            <p class="mb-0 mt-1">
                Quality Shoes. Everyday Comfort.
            </p>
            <small>© 2026 DinSko. All rights reserved.</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>