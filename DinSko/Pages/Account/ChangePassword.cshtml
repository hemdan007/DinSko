@page
@model DinSko.Pages.Account.ChangePasswordModel

<style>
    /* Change password page */
    .password-page {
        background-color: #f7f7f7;
        min-height: 650px;
        padding: 45px 15px;
    }

    /* Main form card */
    .password-card {
        max-width: 650px;
        margin: 0 auto;
        background-color: white;
        padding: 35px;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.07);
    }

    .password-title {
        font-weight: 800;
        color: #171717;
        margin-bottom: 10px;
    }

    .password-subtitle {
        color: #777;
        margin-bottom: 30px;
    }

    .password-card .form-label {
        font-weight: 600;
        color: #333;
        margin-bottom: 8px;
    }

    .password-card .form-control {
        padding: 11px 13px;
        border-radius: 8px;
    }

        .password-card .form-control:focus {
            border-color: #c99b36;
            box-shadow: 0 0 0 0.2rem rgba(201, 155, 54, 0.15);
        }

    /* Password strength section */
    .strength-section {
        background-color: #f8f8f8;
        padding: 18px;
        border-radius: 10px;
        margin-top: 18px;
        margin-bottom: 20px;
    }

    .strength-title {
        font-weight: 600;
        margin-bottom: 10px;
    }

    #strengthBar {
        width: 100%;
        height: 12px;
        accent-color: #999999;
    }

    #passwordFeedback {
        margin-top: 12px;
        margin-bottom: 0;
        padding-left: 20px;
        color: #666;
        font-size: 14px;
    }

    .password-policy {
        color: #777;
        font-size: 14px;
        line-height: 1.8;
    }

    .password-button {
        background-color: #171717;
        color: white;
        border: none;
        padding: 12px;
        border-radius: 8px;
        font-weight: 600;
        width: 100%;
        margin-top: 15px;
    }

        .password-button:hover {
            background-color: #444;
            color: white;
        }

    .validation-message {
        color: #dc3545;
        font-size: 14px;
    }

    @@media (max-width: 576px) {
        .password-card {
            padding: 22px;
        }

        .password-page {
            padding: 25px 10px;
        }
    }
</style>

<div class="password-page">

    <div class="password-card">

        <!-- Page heading -->
        <h1 class="password-title">Change Password</h1>

        <p class="password-subtitle">
            Keep your account secure by using a strong, unique password.
        </p>

        <form method="post">

            <!-- Current password -->
            <div class="mb-4">

                <label asp-for="CurrentPassword" class="form-label">
                    Current Password
                </label>

                <input asp-for="CurrentPassword"
                       type="password"
                       class="form-control"
                       autocomplete="current-password"
                       placeholder="Enter your current password" />

                <span asp-validation-for="CurrentPassword"
                      class="validation-message"></span>

            </div>

            <!-- New password -->
            <div class="mb-3">

                <label asp-for="NewPassword" class="form-label">
                    New Password
                </label>

                <input asp-for="NewPassword"
                       type="password"
                       id="newPasswordInput"
                       class="form-control"
                       autocomplete="new-password"
                       placeholder="Enter your new password" />

                <span asp-validation-for="NewPassword"
                      class="validation-message"></span>

            </div>

            <!-- Password strength meter -->
            <div class="strength-section">

                <p class="strength-title">
                    Password Strength:
                    <strong id="strengthText">Not entered</strong>
                </p>

                <progress id="strengthBar"
                          value="0"
                          max="100">
                </progress>

                <ul id="passwordFeedback">
                    <li>Enter a password to check its strength.</li>
                </ul>

            </div>

            <!-- Password policy -->
            <div class="password-policy mb-4">

                <p class="fw-semibold mb-2">
                    Password Requirements:
                </p>

                <ul>
                    <li>Password must be between 15 and 64 characters.</li>
                    <li>Uppercase and lowercase letters are recommended.</li>
                    <li>Do not use common passwords or personal information.</li>
                    <li>Use a unique password that you do not reuse on other websites.</li>
                </ul>

            </div>

            <!-- Confirm password -->
            <div class="mb-3">

                <label asp-for="ConfirmPassword" class="form-label">
                    Confirm New Password
                </label>

                <input asp-for="ConfirmPassword"
                       type="password"
                       class="form-control"
                       autocomplete="new-password"
                       placeholder="Confirm your new password" />

                <span asp-validation-for="ConfirmPassword"
                      class="validation-message"></span>

            </div>

            <!-- Error message -->
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">
                    @Model.ErrorMessage
                </div>
            }

            <!-- Success message -->
            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert alert-success">
                    @Model.SuccessMessage
                </div>
            }

            <!-- Submit button -->
            <button type="submit" class="password-button">
                Change Password
            </button>

        </form>

    </div>

</div>

@section Scripts {
    <script>
        // get the new password input and result elements
        const passwordInput = document.getElementById("newPasswordInput");
        const strengthText = document.getElementById("strengthText");
        const strengthBar = document.getElementById("strengthBar");
        const passwordFeedback = document.getElementById("passwordFeedback");

        // analyse the password whenever the user types
        passwordInput.addEventListener("input", function () {
            const password = passwordInput.value;
            let score = 0;
            const feedback = [];

            // check password length
            if (password.length >= 15) {
                score += 40;
            } else if (password.length >= 12) {
                score += 30;
                feedback.push("Use at least 15 characters.");
            } else if (password.length >= 8) {
                score += 20;
                feedback.push("Use a longer password.");
            } else if (password.length > 0) {
                score += 10;
                feedback.push("Your password is too short.");
            } else {
                feedback.push("Enter a password to check its strength.");
            }

            // check lowercase letters
            if (/[a-z]/.test(password)) {
                score += 10;
            } else if (password.length > 0) {
                feedback.push("Consider adding lowercase letters.");
            }

            // check uppercase letters
            if (/[A-Z]/.test(password)) {
                score += 10;
            } else if (password.length > 0) {
                feedback.push("Consider adding uppercase letters.");
            }

            // check numbers
            if (/[0-9]/.test(password)) {
                score += 10;
            } else if (password.length > 0) {
                feedback.push("Consider adding numbers.");
            }

            // check special characters
            if (/[^a-zA-Z0-9]/.test(password)) {
                score += 10;
            } else if (password.length > 0) {
                feedback.push("Consider adding special characters.");
            }

            // reduce the score for repeated characters
            if (/(.)\1{3,}/.test(password)) {
                score -= 15;
                feedback.push("Avoid repeating the same character many times.");
            }

            // reduce the score for predictable sequences
            if (/1234|2345|3456|4567|5678|6789|abcd|bcde|cdef|qwerty/i.test(password)) {
                score -= 15;
                feedback.push("Avoid predictable sequences.");
            }

            // keep the score between 0 and 100
            score = Math.max(0, Math.min(100, score));

            // determine the password strength category
            let strength = "";
            let barColor = "";

            if (password.length === 0) {
                strength = "Not entered";
                barColor = "#999999";
            } else if (score < 40) {
                strength = "Weak";
                barColor = "#DC6262";
            } else if (score < 70) {
                strength = "Medium";
                barColor = "#D6A63B";
            } else {
                strength = "Strong";
                barColor = "#39976B";
            }

            // display the category and visual indicator
            strengthText.textContent = strength;
            strengthBar.value = score;
            strengthBar.style.accentColor = barColor;

            // display feedback safely
            passwordFeedback.replaceChildren();

            if (feedback.length === 0 && password.length > 0) {
                feedback.push("Good score! Remember to use a unique password.");
            }

            feedback.forEach(function (message) {
                const item = document.createElement("li");
                item.textContent = message;
                passwordFeedback.appendChild(item);
            });
        });
    </script>
}