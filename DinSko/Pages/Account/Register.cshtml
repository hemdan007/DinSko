@page
@model DinSko.Pages.Account.RegisterModel

<style>
    /* Registration page */
    .register-page {
        background-color: #f7f7f7;
        min-height: 700px;
        padding: 45px 15px;
    }

    /* Registration card */
    .register-card {
        max-width: 600px;
        margin: 0 auto;
        background-color: white;
        padding: 35px;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.07);
    }

    .register-title {
        font-weight: 800;
        color: #171717;
        margin-bottom: 10px;
    }

    .register-subtitle {
        color: #777;
        margin-bottom: 30px;
    }

    .register-card .form-label {
        font-weight: 600;
        color: #333;
        margin-bottom: 8px;
    }

    .register-card .form-control {
        padding: 11px 13px;
        border-radius: 8px;
    }

        .register-card .form-control:focus {
            border-color: #c99b36;
            box-shadow: 0 0 0 0.2rem rgba(201, 155, 54, 0.15);
        }

    /* Password strength section */
    .strength-section {
        background-color: #f8f8f8;
        padding: 18px;
        border-radius: 10px;
        margin-top: 15px;
        margin-bottom: 20px;
    }

    .strength-title {
        font-weight: 600;
        margin-bottom: 10px;
    }

    #strengthBar {
        width: 100%;
        height: 12px;
        accent-color: #999999;
    }

    #passwordFeedback {
        margin-top: 12px;
        margin-bottom: 0;
        padding-left: 20px;
        color: #666;
        font-size: 14px;
    }

    .password-policy {
        color: #777;
        font-size: 14px;
        line-height: 1.8;
    }

    .register-button {
        background-color: #171717;
        color: white;
        border: none;
        padding: 12px;
        border-radius: 8px;
        font-weight: 600;
        width: 100%;
        margin-top: 10px;
    }

        .register-button:hover {
            background-color: #444;
            color: white;
        }

    .validation-message {
        color: #dc3545;
        font-size: 14px;
    }

    .register-footer {
        text-align: center;
        margin-top: 25px;
        color: #777;
    }

        .register-footer a {
            color: #171717;
            font-weight: 600;
            text-decoration: none;
        }

            .register-footer a:hover {
                color: #c99b36;
            }

    @@media (max-width: 576px) {
        .register-card {
            padding: 22px;
        }

        .register-page {
            padding: 25px 10px;
        }
    }
</style>

<div class="register-page">

    <div class="register-card">

        <!-- Page heading -->
        <h1 class="register-title">Create Account</h1>

        <p class="register-subtitle">
            Join DinSko and discover your next favorite shoes.
        </p>

        <form method="post">

            <!-- Name -->
            <div class="mb-4">

                <label asp-for="User.Name" class="form-label">
                    Full Name
                </label>

                <input asp-for="User.Name"
                       class="form-control"
                       autocomplete="name"
                       placeholder="Enter your full name" />

                <span asp-validation-for="User.Name"
                      class="validation-message"></span>

            </div>

            <!-- Email -->
            <div class="mb-4">

                <label asp-for="User.Email" class="form-label">
                    Email Address
                </label>

                <input asp-for="User.Email"
                       type="email"
                       class="form-control"
                       autocomplete="email"
                       placeholder="Enter your email address" />

                <span asp-validation-for="User.Email"
                      class="validation-message"></span>

            </div>

            <!-- Password -->
            <div class="mb-3">

                <label asp-for="User.Password" class="form-label">
                    Password
                </label>

                <input asp-for="User.Password"
                       type="password"
                       id="passwordInput"
                       class="form-control"
                       autocomplete="new-password"
                       placeholder="Create a strong password" />

                <span asp-validation-for="User.Password"
                      class="validation-message"></span>

            </div>

            <!-- Password strength meter -->
            <div class="strength-section">

                <p class="strength-title">
                    Password Strength:
                    <strong id="strengthText">Not entered</strong>
                </p>

                <progress id="strengthBar"
                          value="0"
                          max="100">
                </progress>

                <ul id="passwordFeedback">
                    <li>Enter a password to check its strength.</li>
                </ul>

            </div>

            <!-- Password requirements -->
            <div class="password-policy mb-4">

                <p class="fw-semibold mb-2">
                    Password Requirements:
                </p>

                <ul>
                    <li>Password must be between 15 and 64 characters.</li>
                    <li>Uppercase and lowercase letters are recommended.</li>
                    <li>Do not use common passwords or personal information.</li>
                    <li>Use a unique password that you do not reuse on other websites.</li>
                </ul>

            </div>

            <!-- Submit button -->
            <button type="submit" class="register-button">
                Create Account
            </button>

        </form>

        <!-- Login link -->
        <div class="register-footer">

            Already have an account?

            <a asp-page="/Account/Login">
                Login
            </a>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        // Get the password input and result elements
        const passwordInput = document.getElementById("passwordInput");
        const strengthText = document.getElementById("strengthText");
        const strengthBar = document.getElementById("strengthBar");
        const passwordFeedback = document.getElementById("passwordFeedback");

        // Analyse the password whenever the user types
        passwordInput.addEventListener("input", function () {
            const password = passwordInput.value;
            let score = 0;
            const feedback = [];

            // Check password length
            if (password.length >= 15) {
                score += 40;
            } else if (password.length >= 12) {
                score += 30;
                feedback.push("Use at least 15 characters.");
            } else if (password.length >= 8) {
                score += 20;
                feedback.push("Use a longer password.");
            } else if (password.length > 0) {
                score += 10;
                feedback.push("Your password is too short.");
            } else {
                feedback.push("Enter a password to check its strength.");
            }

            // Check lowercase letters
            if (/[a-z]/.test(password)) {
                score += 10;
            } else if (password.length > 0) {
                feedback.push("Consider adding lowercase letters.");
            }

            // Check uppercase letters
            if (/[A-Z]/.test(password)) {
                score += 10;
            } else if (password.length > 0) {
                feedback.push("Consider adding uppercase letters.");
            }

            // Check numbers
            if (/[0-9]/.test(password)) {
                score += 10;
            } else if (password.length > 0) {
                feedback.push("Consider adding numbers.");
            }

            // Check special characters
            if (/[^a-zA-Z0-9]/.test(password)) {
                score += 10;
            } else if (password.length > 0) {
                feedback.push("Consider adding special characters.");
            }

            // Reduce the score for repeated characters
            if (/(.)\1{3,}/.test(password)) {
                score -= 15;
                feedback.push("Avoid repeating the same character many times.");
            }

            // Reduce the score for predictable sequences
            if (/1234|2345|3456|4567|5678|6789|abcd|bcde|cdef|qwerty/i.test(password)) {
                score -= 15;
                feedback.push("Avoid predictable sequences.");
            }

            // Keep the score between 0 and 100
            score = Math.max(0, Math.min(100, score));

            // Determine the password strength category
            let strength = "";
            let barColor = "";

            if (password.length === 0) {
                strength = "Not entered";
                barColor = "#999999";
            } else if (score < 40) {
                strength = "Weak";
                barColor = "#DC6262";
            } else if (score < 70) {
                strength = "Medium";
                barColor = "#D6A63B";
            } else {
                strength = "Strong";
                barColor = "#39976B";
            }

            // Display the category and visual indicator
            strengthText.textContent = strength;
            strengthBar.value = score;
            strengthBar.style.accentColor = barColor;

            // Display feedback safely
            passwordFeedback.replaceChildren();

            if (feedback.length === 0 && password.length > 0) {
                feedback.push("Good score! Remember to use a unique password.");
            }

            feedback.forEach(function (message) {
                const item = document.createElement("li");
                item.textContent = message;
                passwordFeedback.appendChild(item);
            });
        });
    </script>
}